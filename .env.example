# Campus Facilities AI: environment variables
# Copy this file to .env and fill in your values. .env is never committed (see .gitignore).
# A variable already set in the terminal overrides the value in .env.

# ---------------------------------------------------------------- email intake (Outage Agent)
# replay = replay the supplied correspondence as if it were arriving (default, offline)
# imap   = read a real mailbox, strictly read-only (needs the FAI_IMAP_* values below)
FAI_EMAIL_SOURCE=replay

# Replay start date (ISO date). Only used when FAI_EMAIL_SOURCE=replay.
FAI_REPLAY_SINCE=2026-10-01

# Automatic mailbox checks every N seconds; 0 = only when "Check for new email" is clicked.
FAI_EMAIL_POLL_SECONDS=0

# IMAP mailbox. Get James's consent and Rice IT approval first; prefer a dedicated project
# mailbox and an app password, never a personal main password.
FAI_IMAP_HOST=
FAI_IMAP_USER=
FAI_IMAP_PASSWORD=
FAI_IMAP_FOLDER=INBOX
FAI_IMAP_SINCE_DAYS=14

# ---------------------------------------------------------------- unlocking locked actions (Settings page)
# Master key for the machine. While false, nothing in Settings can be switched on.
FAI_ALLOW_UNLOCK=false

# ---------------------------------------------------------------- outgoing email (needs the 'Send email' switch)
# SMTP server used to send approved drafts. FAI_SMTP_SECURITY: starttls (port 587), ssl (port 465) or none.
# Microsoft 365 usually blocks password sign-in over SMTP; a Microsoft Graph sender can replace this later.
FAI_SMTP_HOST=
FAI_SMTP_PORT=587
FAI_SMTP_SECURITY=starttls
FAI_SMTP_USER=
FAI_SMTP_PASSWORD=
FAI_SMTP_FROM=

# Test address. While 'Deliver to real recipients' is off, every email goes only here,
# with the real recipient list shown at the top of the message.
FAI_EMAIL_REDIRECT_TO=

# ---------------------------------------------------------------- voice assistant (all local; Settings > Voice assistant)
# Ollama server that runs the language model. Models are chosen in Settings from those already installed.
FAI_OLLAMA_URL=http://127.0.0.1:11434
# LangGraph comes with LangSmith tracing support; keep it off so nothing leaves this computer.
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false

# ---------------------------------------------------------------- Microsoft 365 (live outage email and record files, read-only)
# App registration made by Rice IT (Azure portal > App registrations). See README "Live connections".
FAI_GRAPH_TENANT_ID=
FAI_GRAPH_CLIENT_ID=
# device = James signs in himself with a code (recommended); app = unattended, needs FAI_GRAPH_CLIENT_SECRET
FAI_GRAPH_AUTH=device
FAI_GRAPH_CLIENT_SECRET=
# "me" = the signed-in mailbox, or a shared mailbox address such as facilities-outages@rice.edu
FAI_GRAPH_MAILBOX=me
FAI_GRAPH_FOLDER=Inbox
FAI_GRAPH_SINCE_DAYS=14
# To read outage email from Microsoft 365 set FAI_EMAIL_SOURCE=graph (checked every 60 s unless FAI_EMAIL_POLL_SECONDS says otherwise)

# ---------------------------------------------------------------- space and people records (no manual file moves)
# folder = a folder the reports land in by themselves (synced OneDrive/SharePoint folder or a scheduled export)
# microsoft = the two Excel reports in SharePoint/OneDrive, read through the Microsoft 365 connection
FAI_RECORDS_SOURCE=folder
FAI_RECORDS_DIR=
FAI_RECORDS_SPACE_FILE=SpaceRecords.xlsx
FAI_RECORDS_PEOPLE_FILE=Report_PeopleRecords.xlsx
FAI_RECORDS_SPACE_URL=
FAI_RECORDS_PEOPLE_URL=
# check for a new version every N minutes (0 = only when "Check now" is pressed)
FAI_RECORDS_REFRESH_MINUTES=0
